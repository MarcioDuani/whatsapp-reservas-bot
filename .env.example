# .env.example — Copie este arquivo para .env e preencha com seus valores reais
# Nunca commite o arquivo .env no GitHub!

# 1. Configurações da WhatsApp Cloud API (Meta Developers)
# Obtenha em: https://developers.facebook.com/ -> Seu App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAG...SEU_TOKEN_DE_ACESSO_AQUI
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_WABA_ID=2209651766634628
WHATSAPP_VERIFY_TOKEN=meu_token_secreto_webhook
PORT=3000

# 2. Números dos Proprietários para receber comprovantes e aprovações
# Formato internacional puro (ex: 5521993689581). Se for mais de um, separe por vírgula.
NUMEROS_DONOS=5521993689581

# 3. API Key do Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# 4. ID da planilha Google Sheets (encontrado na URL da planilha)
SPREADSHEET_ID=seu_spreadsheet_id_aqui

# 5. Dados do PIX para recebimento do sinal de reserva
CHAVE_PIX=seu_cpf_ou_chave_pix
NOME_BENEFICIARIO=Seu Nome Completo
BANCO_PIX=Nome do seu Banco
