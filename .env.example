# .env.example — Copie este arquivo para .env e preencha com seus valores reais
# Nunca commite o arquivo .env no GitHub!

# API Key do Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=sua_api_key_aqui

# Número do WhatsApp que receberá os comprovantes de PIX
# Formato: código do país + DDD + número + @c.us (sem espaços ou traços)
NUMERO_DONO=5521999999999@c.us

# ID da planilha Google Sheets (encontrado na URL da planilha)
# https://docs.google.com/spreadsheets/d/SEU_ID_AQUI/edit
SPREADSHEET_ID=seu_spreadsheet_id_aqui
